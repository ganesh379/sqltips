     "kind": "comment",
     "text": "-- password: \\password ro_user",
     "at": 4
    },
    {
     "kind": "cmd",
     "text": "GRANT CONNECT ON DATABASE appdb",
     "at": 5,
     "prompt": "appdb=# "
    },
    {
     "kind": "cmd",
     "text": "TO ro_user;",
     "at": 5,
     "prompt": "appdb-# "
    },
    {
     "kind": "out",
     "text": "GRANT",
     "at": 5
    },
    {
     "kind": "cmd",
     "text": "GRANT USAGE ON SCHEMA app",
     "at": 6,
     "prompt": "appdb=# "
    },
    {
     "kind": "cmd",
     "text": "TO ro_user;",
     "at": 6,
     "prompt": "appdb-# "
